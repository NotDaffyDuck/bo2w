# Copy this file to `.env` and edit it. `.env` stays out of git.

# The folder that holds the game trees the engine reads.
BO2MP_GAMES=/path/to/cod-games

# Where `make deploy`, `make publish` and `make logs` send a channel: an ssh
# target and the bo2mp folder on it. Not needed to play locally.
# `make provision` uses the same host and BO2MP_RELEASE_KEY.
BO2MP_DEPLOY_HOST=user@host
BO2MP_DEPLOY_ROOT=/srv/bo2mp

# The folder holding the private CA that signs the master's QUIC certificate
# and the release server's HTTPS certificate. Keep it outside the repository.
BO2MP_RELEASE_KEY=/path/to/release-ca

# The master server `make menu` and a portable Windows install connect to. The
# menu starts when the server is down and keeps retrying in the background.
BO2MP_MASTER_ADDR=master.example.net:4433
BO2MP_MASTER_SERVER_NAME=bo2mp-prod
BO2MP_MASTER_CA_CERT=${BO2MP_RELEASE_KEY}/bo2mp-ca.pem
