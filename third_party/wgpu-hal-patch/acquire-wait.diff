+
+/// bo2mp patch: the first wait for an acquired image. `WGPU_HAL_TEST_ACQUIRE_WAIT_NS` shortens it so a
+/// test can make it run out on purpose and check that the game keeps going; unset, it is `timeout_ns`.
+fn first_wait_ns(timeout_ns: u64) -> u64 {
+    static TEST_WAIT_NS: std::sync::OnceLock<Option<u64>> = std::sync::OnceLock::new();
+    TEST_WAIT_NS
+        .get_or_init(|| {
+            std::env::var("WGPU_HAL_TEST_ACQUIRE_WAIT_NS")
+                .ok()
+                .and_then(|v| v.trim().parse().ok())
+        })
+        .map_or(timeout_ns, |ns| ns.min(timeout_ns))
+}
